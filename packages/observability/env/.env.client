# Browser and native observability values that may be bundled.
# @defaultRequired=true @defaultSensitive=false @defaultDynamic=false

# ---

# Browser Sentry DSN.
PUBLIC_SENTRY_DSN=

# Enables browser Sentry diagnostics.
# @type=boolean
PUBLIC_SENTRY_DEBUG=false

# Expo Sentry DSN.
EXPO_PUBLIC_SENTRY_DSN=

# Expo project organization used during builds.
EXPO_PUBLIC_SENTRY_ORG=

# Expo Sentry project used during builds.
EXPO_PUBLIC_SENTRY_PROJECT=

# Expo Sentry service URL.
# @type=url
EXPO_PUBLIC_SENTRY_URL=https://sentry.io/
