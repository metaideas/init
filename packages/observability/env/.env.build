# Sentry build and source-map upload contract.
# @defaultRequired=true @defaultSensitive=true

# ---

# Credential used only by Sentry build tooling.
SENTRY_AUTH_TOKEN=

# Sentry organization slug used by build tooling.
# @public
SENTRY_ORG=

# Sentry project slug used by build tooling.
# @public
SENTRY_PROJECT=
