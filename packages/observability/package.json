{
  "name": "@init/observability",
  "private": true,
  "description": "Wide-event logging with evlog, error tracking and monitoring with Sentry",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./logger": "./src/logger/index.ts",
    "./logger/*": "./src/logger/*.ts",
    "./monitoring": "./src/monitoring/index.ts",
    "./monitoring/*": "./src/monitoring/*.ts",
    "./uptime": "./src/uptime.ts"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "varlock codegen",
    "env:check": "varlock load"
  },
  "dependencies": {
    "@init/utils": "workspace:*",
    "@openstatus/react": "^0.0.3",
    "@sentry/browser": "10.32.1",
    "@sentry/core": "10.32.1",
    "@sentry/node": "10.32.1",
    "@sentry/react-native": "~7.11.0",
    "evlog": "^2.26.0",
    "varlock": "1.16.0"
  },
  "devDependencies": {
    "@tooling/tsconfig": "workspace:*",
    "@types/react": "19.2.4",
    "hono": "4.12.32",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
