# Email delivery runtime contract.
# @defaultRequired=true @defaultSensitive=true

# ---

# Sender used when a message does not provide one.
# @public
EMAIL_FROM=

# Resend API credential. Email goes through Resend when it is set.
# @optional
RESEND_API_KEY=

# SMTP server used when no Resend key is set, such as Mailpit from Docker Compose. The URL can
# carry credentials, as in `smtps://user:password@host:465`.
# @optional @type=url
SMTP_URL=
