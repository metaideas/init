{
  "name": "@init/email",
  "private": true,
  "description": "Email templating and sending service using Resend",
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./templates/*": "./src/templates/*.tsx"
  },
  "scripts": {
    "build": "email build --dir src/templates",
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "email dev --dir src/templates --port 4000",
    "export": "email export --dir src/templates"
  },
  "dependencies": {
    "@init/core": "workspace:*",
    "@init/env": "workspace:*",
    "@init/observability": "workspace:*",
    "@init/utils": "workspace:*",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "date-fns": "4.1.0",
    "qte": "0.1.1",
    "resend": "6.7.0"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.1",
    "@tooling/tsconfig": "workspace:*",
    "@types/react": "19.1.13",
    "react": "19.1.0",
    "react-email": "6.9.1",
    "typescript": "7.0.2"
  }
}
