{
  "name": "@init/email",
  "private": true,
  "description": "Email templating and sending service using Resend",
  "type": "module",
  "exports": {
    "./client": "./src/client.ts",
    "./templates/*": "./src/templates/*.tsx"
  },
  "scripts": {
    "build": "email build --dir src/templates",
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "varlock codegen",
    "dev": "email dev --dir src/templates --port ${PORT:-4001}",
    "env:check": "varlock load",
    "export": "email export --dir src/templates"
  },
  "dependencies": {
    "@init/core": "workspace:*",
    "@init/observability": "workspace:*",
    "@init/utils": "workspace:*",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "date-fns": "4.1.0",
    "humanspan": "0.2.0",
    "resend": "6.7.0",
    "varlock": "1.16.0"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.1",
    "@tooling/tsconfig": "workspace:*",
    "@types/react": "19.2.4",
    "react": "19.2.3",
    "react-email": "6.9.1",
    "typescript": "7.0.2"
  }
}
