{
  "name": "@init/payments",
  "private": true,
  "description": "Payment processing utilities using Stripe",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./client": "./src/client.ts",
    "./helpers": "./src/helpers.ts",
    "./browser": "./src/browser.ts"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
