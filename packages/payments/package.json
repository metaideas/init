  },
  "dependencies": {
    "@init/kv": "workspace:*",
    "@init/utils": "workspace:*",
    "@stripe/react-stripe-js": "5.4.1",
    "@stripe/stripe-js": "8.6.1",
    "stripe": "20.1.2",
    "varlock": "1.16.0"
  },
  "devDependencies": {
    "@tooling/tsconfig": "workspace:*",
    "typescript": "7.0.2"
  }
}
