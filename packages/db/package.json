{
  "name": "@init/db",
  "private": true,
  "description": "Database client and ORM using Drizzle",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./helpers": "./src/helpers.ts",
    "./schema": "./src/schema.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "portless",
    "dev:app": "bun --bun drizzle-kit studio --port ${PORT:-4983}",
    "generate": "bun --bun drizzle-kit generate",
    "migrate": "bun --bun drizzle-kit migrate",
    "push": "bun --bun drizzle-kit push",
    "reset": "bun --bun run ./scripts/reset.ts",
    "seed": "bun --bun run ./scripts/seed.ts"
  },
  "dependencies": {
    "@init/env": "workspace:*",
    "@init/observability": "workspace:*",
    "@init/utils": "workspace:*",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3"
  },
  "devDependencies": {
    "@tooling/tsconfig": "workspace:*",
    "drizzle-kit": "0.31.8",
    "drizzle-seed": "0.3.1",
    "postgres": "3.4.8",
    "typescript": "7.0.2"
  },
  "portless": {
    "name": "db.init",
    "script": "dev:app"
  }
}
