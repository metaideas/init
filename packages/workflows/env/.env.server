# Inngest runtime contract.
# @defaultRequired=true @defaultSensitive=true

# ---

# Optional self-hosted or local Inngest endpoint.
# @optional @public @type=url
INNGEST_BASE_URL=

# Enables Inngest development mode.
# @public @type=boolean
INNGEST_DEV=false

# Inngest event ingestion credential.
INNGEST_EVENT_KEY=

# Primary Inngest signing credential.
INNGEST_SIGNING_KEY=

# Previous signing credential accepted during rotation.
# @optional
INNGEST_SIGNING_KEY_FALLBACK=
