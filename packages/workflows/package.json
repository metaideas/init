{
  "name": "@init/workflows",
  "private": true,
  "description": "Background tasks and workflows using Inngest",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./serve": "./src/serve.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "inngest dev --port ${PORT:-8288} --connect-executor-grpc-port $(( ${PORT:-8288} + 10000 )) --connect-gateway-grpc-port $(( ${PORT:-8288} + 11000 )) --connect-gateway-port $(( ${PORT:-8288} + 12000 ))"
  },
  "dependencies": {
    "@init/observability": "workspace:*",
    "@init/utils": "workspace:*",
    "inngest": "4.14.0"
  },
  "devDependencies": {
    "@tooling/tsconfig": "workspace:*",
    "inngest-cli": "1.40.0",
    "typescript": "7.0.2"
  }
}
