{
  "name": "@init/auth",
  "private": true,
  "description": "Authentication utilities using Better Auth",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./client": "./src/client/index.ts",
    "./client/plugins": "./src/client/plugins.ts",
    "./constants": "./src/constants.ts",
    "./expo/*": "./src/expo/*.ts",
    "./integrations/expo/*": "./src/integrations/expo/*.ts",
    "./integrations/start": "./src/integrations/start.ts",
    "./permissions": "./src/permissions.ts",
    "./server": "./src/server/index.ts",
    "./server/plugins": "./src/server/plugins.ts"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "secret": "bunx auth@latest secret"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "@better-auth/expo": "1.6.25",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "humanspan": "0.2.0"
  },
  "devDependencies": {
    "@tooling/tsconfig": "workspace:*",
    "typescript": "7.0.2"
  }
}
