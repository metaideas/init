# Authentication secrets and trusted request origins.
# @defaultRequired=true @defaultSensitive=true

# ---

# Secret used to sign authentication data.
# @type=string(minLength=8)
AUTH_SECRET=

# Origins allowed to initiate authentication requests.
# @public @type=array(string)
AUTH_TRUSTED_ORIGINS=

# Public identifier for the GitHub OAuth application.
# @public
GITHUB_CLIENT_ID=

# Secret for the GitHub OAuth application.
GITHUB_CLIENT_SECRET=

# Public identifier for the Google OAuth application.
# @public
GOOGLE_CLIENT_ID=

# Secret for the Google OAuth application.
GOOGLE_CLIENT_SECRET=
