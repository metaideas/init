{
  "$schema": "https://v2-10-7.turborepo.dev/schema.json",
  "globalPassThroughEnv": ["CI", "VARLOCK_ENV", "_VARLOCK_ENV_KEY"],
  "concurrency": "15",
  "tasks": {
    "build": {
      "dependsOn": ["codegen", "^codegen"],
      "env": [
        "ALLOWED_API_ORIGINS",
        "ARCJET_KEY",
        "AUTH_*",
        "BASE_URL",
        "DATABASE_URL",
        "EMAIL_FROM",
        "EXPO_PUBLIC_*",
        "FILES_API_SECRET",
        "GITHUB_*",
        "GOOGLE_*",
        "INNGEST_*",
        "MOCK_RESEND",
        "PORT",
        "POSTHOG_*",
        "PUBLIC_*",
        "REDIS_URL",
        "RESEND_API_KEY",
        "RUN_PRODUCTION_MIGRATIONS",
        "S3_*",
        "SENTRY_*",
        "STRIPE_*"
      ]
    },
    "clean": {
      "cache": false,
      "dependsOn": ["^clean"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "cache": false
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "studio": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "codegen": {
      "dependsOn": ["typegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/env/**",
        "$TURBO_ROOT$/tooling/internationalization/**"
      ],
      "outputs": [
        "src/env.generated.ts",
        "src/shared/env.generated.ts",
        "src/shared/internationalization/**"
      ]
    },
    "env:check": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "env:scan": {
      "cache": false,
      "dependsOn": ["env:scan:build"]
    },
    "env:scan:build": {
      "cache": false,
      "dependsOn": ["codegen", "^codegen"]
    },
    "typegen": {},
    "//#analyze": {},
    "//#check": {},
    "//#check:monorepo": {},
    "//#fix": {},
    "//#fix:monorepo": {},
    "//#format": {}
  },
  "ui": "tui"
}
