{
  "name": "init",
  "version": "1.3.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ]
  },
  "type": "module",
  "scripts": {
    "analyze": "adamantite analyze",
    "boundaries": "turbo boundaries",
    "build": "turbo build",
    "bump:deps": "bun update --interactive --recursive",
    "check": "adamantite check",
    "check:monorepo": "adamantite monorepo",
    "clean": "turbo clean && git clean -xdf .cache .turbo dist node_modules",
    "codegen": "turbo run codegen --continue --concurrency=1",
    "db:migrate": "turbo --filter @init/db migrate",
    "db:push": "turbo --filter @init/db push",
    "dev": "turbo run dev",
    "dev:apps": "turbo run dev --filter=!@init/*",
    "dev:packages": "turbo run dev --filter=@init/*",
    "docker:down": "docker compose -f infra/local/docker-compose.yml down",
    "docker:up": "docker compose -f infra/local/docker-compose.yml up -d",
    "fix": "adamantite fix",
    "fix:monorepo": "adamantite monorepo --fix",
    "format": "adamantite format",
    "generate": "bun --bun turbo generate",
    "scripts": "bun run scripts/index.ts",
    "start": "turbo run start",
    "template": "bun --bun run scripts/index.ts template",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typegen": "turbo run typegen --continue"
  },
  "devDependencies": {
    "@turbo/gen": "2.10.7",
    "@types/bun": "1.3.14",
    "@types/yargs": "17.0.35",
    "adamantite": "0.33.2",
    "consola": "3.4.2",
    "faultier": "3.0.1",
    "knip": "6.29.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "oxlint-tsgolint": "7.0.2001",
    "sherif": "1.13.0",
    "turbo": "2.10.7",
    "typescript": "7.0.2",
    "yargs": "18.0.0"
  },
  "overrides": {
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14",
  "bun-create": {
    "postinstall": "echo 'Next step: run `bun template setup` to configure your project.'"
  },
  "init": {
    "cleanupPaths": [
      ".github/workflows/opencode.yml",
      ".plans",
      "docs/research"
    ]
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@sentry/cli",
    "@tailwindcss/oxide",
    "docs",
    "extension"
  ]
}
