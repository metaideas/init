{
  "name": "init",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ]
  },
  "type": "module",
  "scripts": {
    "analyze": "adamantite analyze",
    "boundaries": "turbo boundaries",
    "build": "turbo build",
    "bump:deps": "bun update --interactive --recursive",
    "check": "adamantite check",
    "clean": "turbo clean && git clean -xdf .cache .turbo dist node_modules",
    "codegen": "turbo run codegen --continue --ui=stream --output-logs=errors-only",
    "db:migrate": "turbo --filter @init/db migrate",
    "db:push": "turbo --filter @init/db push",
    "dev": "turbo run dev",
    "dev:apps": "turbo run dev --filter=!@init/*",
    "dev:packages": "turbo run dev --filter=@init/*",
    "docker:down": "docker compose -f infra/local/docker-compose.yml down",
    "docker:up": "docker compose -f infra/local/docker-compose.yml up -d --remove-orphans",
    "env:check": "turbo run env:check --continue",
    "env:scan": "turbo run env:scan --continue",
    "fix": "adamantite fix",
    "generate": "bun --bun turbo generate",
    "scripts": "bun run scripts/index.ts",
    "start": "turbo run start",
    "template": "bun run scripts/index.ts template",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@turbo/gen": "2.10.7",
    "@types/bun": "1.4.2",
    "adamantite": "0.41.0",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "knip": "6.32.2",
    "oxfmt": "0.65.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "sherif": "1.13.0",
    "turbo": "2.10.7",
    "typescript": "7.0.2",
    "varlock": "1.16.0"
  },
  "overrides": {
    "@types/react": "19.2.4",
    "@types/react-dom": "19.2.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2",
  "bun-create": {
    "postinstall": "echo 'Next step: run `bun template setup`, or ask your coding agent to use the setup skill.'"
  },
  "init": {
    "cleanupPaths": [
      ".github/workflows/pullfrog.yml"
    ],
    "cleanupSections": [
      "AGENTS.md"
    ]
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@sentry/cli",
    "@tailwindcss/oxide",
    "docs",
    "electron",
    "extension",
    "inngest-cli"
  ]
}
