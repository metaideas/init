import { Button } from "{{nativeUiPackage}}/components/button"
import { Text } from "{{nativeUiPackage}}/components/text"
import { TextInput, View } from "react-native"
import { useEmailSignIn } from "#shared/use-email-sign-in.ts"

export default function SignInScreen() {
  const form = useEmailSignIn()

  return (
    <View className="flex-1 justify-center gap-4 bg-background px-6">
      <Text className="text-2xl font-semibold">Sign in</Text>
      <TextInput
        autoCapitalize="none"
        autoComplete="email"
        className="rounded-md border border-input px-4 py-3 text-foreground"
        keyboardType="email-address"
        onChangeText={form.setEmail}
        placeholder="Email"
        value={form.email}
      />
      <TextInput
        autoComplete="current-password"
        className="rounded-md border border-input px-4 py-3 text-foreground"
        onChangeText={form.setPassword}
        placeholder="Password"
        secureTextEntry
        value={form.password}
      />
      {form.error ? (
        <Text className="text-destructive" role="alert">
          {form.error}
        </Text>
      ) : null}
      <Button onPress={() => void form.signIn()}>
        <Text>Sign in</Text>
      </Button>
    </View>
  )
}
