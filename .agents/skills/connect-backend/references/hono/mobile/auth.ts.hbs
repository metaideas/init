import { adminClient, createAuthClient, organizationClient } from "{{authPackage}}/client"
import { AUTH_API_COOKIE_PREFIX } from "{{authPackage}}/constants"
import { expoClient } from "{{authPackage}}/expo"
import * as SecureStore from "expo-secure-store"
import { buildApiUrl } from "#shared/utils.ts"

export const auth = createAuthClient(buildApiUrl("/auth"), [
  expoClient({ cookiePrefix: AUTH_API_COOKIE_PREFIX, storage: SecureStore }),
  adminClient(),
  organizationClient(),
])

export const { useSession } = auth

export function getAuthHeaders() {
  const cookie = auth.getCookie()
  return cookie ? { Cookie: cookie } : {}
}
