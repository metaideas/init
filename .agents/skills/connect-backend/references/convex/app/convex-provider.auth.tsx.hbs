import type { PropsWithChildren } from "react"
import type { ConvexReactClient } from "{{backendPackage}}/client"
import type { AuthClient } from "{{backendPackage}}/client/auth"
import { ConvexBetterAuthProvider } from "{{backendPackage}}/client/auth"
import { authClient } from "#shared/auth.ts"

const convexAuth = authClient as unknown as AuthClient

export default function ConvexProvider({
  children,
  client,
}: PropsWithChildren<{ client: ConvexReactClient }>) {
  return (
    <ConvexBetterAuthProvider authClient={convexAuth} client={client}>
      {children}
    </ConvexBetterAuthProvider>
  )
}
