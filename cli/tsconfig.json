{
  "extends": "adamantite/typescript",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "target": "esnext",
    "types": ["bun"]
  },
  "include": [
    "src",
    "scripts",
    "bunup.config.ts",
    "knip.config.ts",
    "oxfmt.config.ts",
    "oxlint.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
