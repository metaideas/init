{
  "name": "docs",
  "private": true,
  "description": "Documentation site using Astro and Starlight",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "bun run --parallel \"codegen:*\"",
    "codegen:env": "varlock codegen",
    "codegen:i18n": "paraglide-js compile --project ../../tooling/internationalization/project.inlang --outdir ./src/shared/internationalization",
    "dev": "portless",
    "dev:app": "astro dev",
    "env:check": "varlock load",
    "env:scan": "test -d dist && varlock scan --path .env.schema --path .env.development dist",
    "env:scan:build": "astro build",
    "preview": "astro preview",
    "typegen": "astro sync"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/starlight": "0.41.4",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@init/analytics": "workspace:*",
    "@init/utils": "workspace:*",
    "astro": "7.1.4",
    "sharp": "0.35.3",
    "varlock": "1.16.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "1.10.6",
    "@inlang/paraglide-js": "2.23.0",
    "@tailwindcss/vite": "4.3.3",
    "@tooling/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "@varlock/astro-integration": "1.3.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  },
  "portless": {
    "name": "docs.init",
    "script": "dev:app"
  }
}
