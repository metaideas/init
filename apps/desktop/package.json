{
  "name": "desktop",
  "private": true,
  "description": "Tauri desktop application with TanStack Router",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "tauri build",
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "bun run --parallel \"codegen:*\"",
    "codegen:env": "varlock codegen",
    "codegen:i18n": "paraglide-js compile --project ../../tooling/internationalization/project.inlang --outdir ./src/shared/internationalization",
    "dev": "portless",
    "dev:app": "tauri dev",
    "env:check": "varlock load",
    "env:scan": "test -d dist && varlock scan --path .env.schema dist",
    "env:scan:build": "bun --bun vite build"
  },
  "dependencies": {
    "@init/observability": "workspace:*",
    "@init/ui": "workspace:*",
    "@init/utils": "workspace:*",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-devtools": "5.91.2",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tauri-apps/api": "2.9.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "varlock": "1.16.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@inlang/paraglide-js": "2.23.0",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/router-plugin": "1.168.23",
    "@tauri-apps/cli": "2.9.6",
    "@tooling/tsconfig": "workspace:*",
    "@types/babel__core": "7.20.5",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.1.9",
    "@varlock/vite-integration": "1.4.0",
    "@vitejs/plugin-react": "6.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "portless": {
    "name": "desktop.init",
    "script": "dev:app"
  }
}
