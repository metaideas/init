# @currentEnv=$VARLOCK_ENV
# @generateTsTypes(path=./src/shared/env.generated.ts, exposeEnv=local)
# @defaultRequired=false @defaultSensitive=false @defaultDynamic=false

# ---

# Tauri development host supplied by the native CLI.
# @optional @dynamic
TAURI_DEV_HOST=

# Tauri target architecture.
# @optional @dynamic
TAURI_ENV_ARCH=

# Whether Tauri is producing a debug build.
# @optional @dynamic @type=boolean
TAURI_ENV_DEBUG=false

# Tauri target family.
# @optional @dynamic
TAURI_ENV_FAMILY=

# Tauri target platform.
# @optional @dynamic
TAURI_ENV_PLATFORM=

# Tauri target platform version.
# @optional @dynamic
TAURI_ENV_PLATFORM_VERSION=

# Tauri target triple.
# @optional @dynamic
TAURI_ENV_TARGET_TRIPLE=

# Local Vite server port.
# @dynamic @type=port
PORT=3003
