{
  "name": "web",
  "private": true,
  "description": "Astro marketing site and blog",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "paraglide-js compile --project ../../tooling/internationalization/project.inlang --outdir ./src/shared/internationalization",
    "dev": "astro dev",
    "preview": "astro preview",
    "typegen": "astro sync"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.4",
    "@astrojs/react": "6.0.1",
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@init/env": "workspace:*",
    "@init/ui": "workspace:*",
    "@init/utils": "workspace:*",
    "astro": "7.1.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "simple-icons": "16.27.1",
    "std-env": "4.2.0"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "1.10.6",
    "@inlang/paraglide-js": "2.23.0",
    "@tailwindcss/vite": "4.3.3",
    "@tooling/env": "workspace:*",
    "@tooling/tsconfig": "workspace:*",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
