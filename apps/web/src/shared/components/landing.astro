---
import { site, technologies } from "#shared/site"
---

<div class="landing">
  <div class="grid-plane grid-plane--north" aria-hidden="true"></div>
  <div class="grid-plane grid-plane--south" aria-hidden="true"></div>
  <div class="horizon" aria-hidden="true"></div>

  <header class="header">
    <a class="wordmark" href="/" aria-label="Init home">
      <svg viewBox="0 0 28 28" aria-hidden="true">
        <path d="M5 4.5 23 14 5 23.5V4.5Z"></path>
        <path d="m8.75 9.3 8.9 4.7-8.9 4.7V9.3Z"></path>
      </svg>
      <span>init</span>
    </a>

    <nav aria-label="Primary navigation">
      <a class="nav-link" href={site.githubUrl}>
        <span>GitHub</span>
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M5 3h8v8M13 3 3 13"></path>
        </svg>
      </a>
    </nav>
  </header>

  <main class="hero">
    <p class="eyebrow"><span>init.now</span><span aria-hidden="true">/</span><span>typescript launchpad</span></p>

    <h1 aria-label={site.tagline}>
      <span class="headline-line headline-line--first" aria-hidden="true">Start once.</span>
      <span class="headline-line headline-line--second" aria-hidden="true">Ship everywhere.</span>
    </h1>

    <p class="description">{site.description}</p>

    <div class="command-wrap">
      <span class="command-label" aria-hidden="true">$</span>
      <code>{site.command}</code>
      <button
        class="copy-button"
        type="button"
        data-copy-command={site.command}
        aria-label="Copy scaffold command"
      >
        <svg class="copy-icon" viewBox="0 0 18 18" aria-hidden="true">
          <rect x="6.25" y="6.25" width="8.5" height="8.5" rx="1.5"></rect>
          <path d="M3.25 11.75h-.5a1.5 1.5 0 0 1-1.5-1.5v-7.5a1.5 1.5 0 0 1 1.5-1.5h7.5a1.5 1.5 0 0 1 1.5 1.5v.5"></path>
        </svg>
        <svg class="check-icon" viewBox="0 0 18 18" aria-hidden="true">
          <path d="m3 9.5 3.5 3.5L15 4.5"></path>
        </svg>
        <span class="copy-label">Copy</span>
      </button>
      <span class="sr-only" aria-live="polite" data-copy-status></span>
    </div>

    <p class="hero-note">One repository. Every surface. Your code from the first commit.</p>
  </main>

  <section class="featuring" aria-labelledby="featuring-title">
    <p id="featuring-title">Featuring</p>
    <div class="marquee">
      <div class="marquee-track">
        <ul>
          {technologies.map((technology) => (
            <li>
              <span>{technology.name}</span>
              <small>{technology.detail}</small>
            </li>
          ))}
        </ul>
        <ul aria-hidden="true">
          {technologies.map((technology) => (
            <li>
              <span>{technology.name}</span>
              <small>{technology.detail}</small>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <footer class="footer">
    <p>Open source, built to become yours.</p>
    <div>
      <a href={site.githubUrl}>GitHub</a>
      <a href="https://opensource.org/license/mit">MIT License</a>
    </div>
  </footer>
</div>

<script>
  import { site } from "#shared/site"

  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-command]")
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]")
  let resetTimer: ReturnType<typeof setTimeout> | undefined

  const copyCommand = async function () {
    if (!copyButton || !copyStatus) return

    await navigator.clipboard.writeText(site.command)
    copyButton.dataset.copied = "true"
    copyButton.setAttribute("aria-label", "Scaffold command copied")
    const copyLabel = copyButton.querySelector(".copy-label")
    if (copyLabel) copyLabel.textContent = "Copied"
    copyStatus.textContent = "Scaffold command copied to clipboard."

    clearTimeout(resetTimer)
    resetTimer = setTimeout(() => {
      copyButton.dataset.copied = "false"
      copyButton.setAttribute("aria-label", "Copy scaffold command")
      if (copyLabel) copyLabel.textContent = "Copy"
      copyStatus.textContent = ""
    }, 2000)
  }

  copyButton?.addEventListener("click", () => {
    copyCommand().catch(() => {
      if (copyStatus) copyStatus.textContent = "Could not copy the command."
    })
  })
</script>

<style>
  :global(:root) {
    color-scheme: dark;
    --site-bg: #080a0d;
    --site-panel: #0d1116;
    --site-line: #252b33;
    --site-muted: #8b949e;
    --site-text: #f1f3f5;
    --site-signal: #7dd3fc;
  }

  :global(html) {
    background: var(--site-bg);
  }

  :global(body) {
    margin: 0;
    min-width: 20rem;
    background: var(--site-bg);
    color: var(--site-text);
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
  }

  :global(*) {
    box-sizing: border-box;
  }

  :global(a) {
    color: inherit;
  }

  :global(.sr-only) {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .landing {
    position: relative;
    display: grid;
    min-height: 100svh;
    grid-template-rows: auto minmax(33rem, 1fr) auto auto;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(circle at 50% 48%, rgb(125 211 252 / 8%), transparent 28rem),
      var(--site-bg);
  }

  .header {
    position: relative;
    z-index: 5;
    display: flex;
    width: min(100% - 2rem, 86rem);
    align-items: center;
    justify-content: space-between;
    justify-self: center;
    padding: 1.25rem 0;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--site-text);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9rem;
    font-weight: 650;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .wordmark svg {
    width: 1.4rem;
    fill: var(--site-text);
  }

  .wordmark svg path:last-child {
    fill: var(--site-bg);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid var(--site-line);
    border-radius: 999px;
    padding: 0.55rem 0.8rem 0.55rem 0.95rem;
    background: rgb(13 17 22 / 78%);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.72rem;
    text-decoration: none;
    transition:
      border-color 180ms ease,
      background 180ms ease;
  }

  .nav-link:hover {
    border-color: #46515f;
    background: #121820;
  }

  .nav-link svg {
    width: 0.8rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .hero {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(100% - 2rem, 72rem);
    flex-direction: column;
    align-items: center;
    align-self: center;
    justify-self: center;
    padding: 4.5rem 0 6rem;
    text-align: center;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1.75rem;
    color: var(--site-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(0.61rem, 1.5vw, 0.72rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow span:first-child {
    color: var(--site-signal);
  }

  h1 {
    margin: 0;
    font-family: "Arial Narrow", "Avenir Next Condensed", "Helvetica Neue", sans-serif;
    font-size: clamp(3.35rem, 10.3vw, 9rem);
    font-stretch: condensed;
    font-weight: 760;
    letter-spacing: -0.075em;
    line-height: 0.83;
    text-wrap: balance;
  }

  .headline-line {
    display: block;
    animation: reveal-line 900ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .headline-line--second {
    color: transparent;
    -webkit-text-stroke: 1px #69727d;
    animation-delay: 110ms;
  }

  .description {
    max-width: 36rem;
    margin: 2rem 0 0;
    color: #aab1b9;
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    line-height: 1.6;
    text-wrap: balance;
  }

  .command-wrap {
    display: grid;
    width: min(100%, 34rem);
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    margin-top: 2.25rem;
    border: 1px solid #303842;
    border-radius: 0.8rem;
    padding: 0.35rem;
    background: rgb(13 17 22 / 92%);
    box-shadow:
      0 1.5rem 5rem rgb(0 0 0 / 32%),
      inset 0 1px rgb(255 255 255 / 4%);
    text-align: left;
  }

  .command-label {
    padding-left: 0.9rem;
    color: var(--site-signal);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.8rem;
  }

  .command-wrap code {
    overflow: hidden;
    padding: 0.8rem 0.65rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(0.68rem, 2.2vw, 0.83rem);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .copy-button {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid #38414c;
    border-radius: 0.55rem;
    padding: 0.7rem 0.75rem;
    background: #161c24;
    color: #c8cdd2;
    cursor: pointer;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.68rem;
    transition:
      border-color 160ms ease,
      color 160ms ease,
      transform 160ms ease;
  }

  .copy-button:hover {
    border-color: #5b6978;
    color: var(--site-text);
  }

  .copy-button:active {
    transform: translateY(1px);
  }

  .copy-button:focus-visible,
  a:focus-visible {
    border-radius: 0.35rem;
    outline: 2px solid var(--site-signal);
    outline-offset: 3px;
  }

  .copy-button svg {
    width: 0.85rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .check-icon {
    display: none;
  }

  .copy-button[data-copied="true"] {
    border-color: rgb(125 211 252 / 55%);
    color: var(--site-signal);
  }

  .copy-button[data-copied="true"] .copy-icon {
    display: none;
  }

  .copy-button[data-copied="true"] .check-icon {
    display: block;
  }

  .hero-note {
    margin: 1rem 0 0;
    color: #626b75;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.65rem;
  }

  .grid-plane {
    position: absolute;
    z-index: 0;
    left: -20%;
    width: 140%;
    height: 52%;
    background-image:
      linear-gradient(rgb(68 79 91 / 46%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(68 79 91 / 46%) 1px, transparent 1px);
    background-size: 4rem 2.25rem;
    pointer-events: none;
  }

  .grid-plane--north {
    top: -24%;
    transform: perspective(44rem) rotateX(-66deg);
    transform-origin: center bottom;
    mask-image: linear-gradient(to bottom, transparent 5%, black 68%, transparent 100%);
  }

  .grid-plane--south {
    bottom: -25%;
    transform: perspective(38rem) rotateX(68deg);
    transform-origin: center top;
    mask-image: linear-gradient(to top, transparent 5%, black 72%, transparent 100%);
  }

  .horizon {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: 15%;
    width: 70%;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(125 211 252 / 28%), transparent);
    box-shadow: 0 0 4rem 1rem rgb(125 211 252 / 5%);
  }

  .featuring {
    position: relative;
    z-index: 3;
    display: grid;
    width: 100%;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: stretch;
    border-block: 1px solid var(--site-line);
    background: rgb(8 10 13 / 85%);
  }

  .featuring > p {
    display: flex;
    align-items: center;
    margin: 0;
    border-right: 1px solid var(--site-line);
    padding: 0 1.4rem;
    color: #7a838d;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .marquee {
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, black 4rem, black calc(100% - 4rem), transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee 38s linear infinite;
  }

  .marquee ul {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .marquee li {
    position: relative;
    display: flex;
    min-width: 9.5rem;
    flex-direction: column;
    gap: 0.15rem;
    padding: 1.05rem 1.5rem;
  }

  .marquee li::after {
    position: absolute;
    top: 50%;
    right: 0;
    width: 2px;
    height: 2px;
    border-radius: 50%;
    background: #48515b;
    content: "";
  }

  .marquee span {
    font-size: 0.82rem;
    font-weight: 570;
  }

  .marquee small {
    color: #68717b;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.57rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .footer {
    position: relative;
    z-index: 3;
    display: flex;
    width: min(100% - 2rem, 86rem);
    align-items: center;
    justify-content: space-between;
    justify-self: center;
    padding: 1.4rem 0;
    color: #68717b;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.62rem;
  }

  .footer p {
    margin: 0;
  }

  .footer div {
    display: flex;
    gap: 1.2rem;
  }

  .footer a {
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--site-text);
  }

  @keyframes reveal-line {
    from {
      opacity: 0;
      transform: translateY(0.45em);
      clip-path: inset(100% 0 0);
    }
    to {
      opacity: 1;
      transform: translateY(0);
      clip-path: inset(0);
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 40rem) {
    .landing {
      grid-template-rows: auto minmax(34rem, 1fr) auto auto;
    }

    .hero {
      padding: 3rem 0 4rem;
    }

    .eyebrow span:last-child {
      display: none;
    }

    h1 {
      font-size: clamp(3.25rem, 17vw, 5rem);
      line-height: 0.88;
    }

    .description {
      max-width: 20rem;
      margin-top: 1.5rem;
    }

    .copy-label {
      display: none;
    }

    .copy-button {
      padding-inline: 0.75rem;
    }

    .hero-note {
      max-width: 18rem;
      line-height: 1.5;
    }

    .grid-plane {
      left: -75%;
      width: 250%;
    }

    .featuring {
      grid-template-columns: 1fr;
    }

    .featuring > p {
      border-right: 0;
      border-bottom: 1px solid var(--site-line);
      padding: 0.65rem 1rem;
    }

    .marquee {
      mask-image: none;
    }

    .footer {
      align-items: flex-start;
      gap: 1rem;
    }

    .footer p {
      max-width: 9rem;
      line-height: 1.5;
    }

    .footer div {
      flex-direction: column;
      align-items: flex-end;
      gap: 0.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .headline-line,
    .marquee-track {
      animation: none;
    }

    .marquee {
      overflow-x: auto;
      mask-image: none;
    }

    .marquee ul[aria-hidden="true"] {
      display: none;
    }
  }
</style>
