---
import FooterControls from "#features/landing/components/footer-controls.tsx"
import { COMPANY_NAME, COMPANY_URL } from "#shared/constants.ts"
import { m } from "#shared/internationalization/messages.js"

const currentYear = new Date().getFullYear()
---

<footer
  class="relative z-3 w-full border-t border-neutral-200 bg-white/90 text-neutral-600 dark:border-[#252b33] dark:bg-[#080a0d]/90 dark:text-neutral-400"
>
  <div
    class="mx-auto my-3 flex min-h-20 w-full max-w-[90rem] flex-col items-center justify-center gap-0 px-4 py-1 sm:my-0 sm:min-h-[4.5rem] sm:flex-row sm:justify-between sm:px-7 sm:py-0"
  >
    <p
      class="flex min-h-8 w-full flex-wrap items-center justify-center gap-x-1.5 gap-y-1 text-center text-sm sm:w-auto sm:justify-start sm:text-left"
    >
      <span>{m.web_landing_footer_copyright()}</span>
      <a
        class="group relative inline-flex items-center gap-1 rounded-sm whitespace-nowrap text-current transition-colors duration-150 after:absolute after:-inset-x-1 after:-inset-y-3 hover:text-neutral-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral-500 dark:hover:text-white"
        href={COMPANY_URL}
      >
        <img class="size-5 shrink-0 dark:invert" src="/logo.svg" alt="" width="20" height="20" />
        <span class="underline-offset-4 group-hover:underline">{COMPANY_NAME}</span>
      </a>
      <span>{m.web_landing_footer_rights({ year: currentYear })}</span>
    </p>

    <nav class="flex w-full justify-center sm:w-auto" aria-label="Footer">
      <FooterControls client:load />
    </nav>
  </div>
</footer>
