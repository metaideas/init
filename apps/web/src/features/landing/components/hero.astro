---
import { SCAFFOLD_COMMAND } from "#shared/constants.ts"
import ShipTargets from "#features/landing/components/ship-targets.astro"
import { m } from "#shared/internationalization/messages.js"

const tagline = `${m.web_landing_hero_headline_first()} ${m.web_landing_hero_headline_second()}`
---

<main
  class="relative z-2 flex w-[min(100%-2rem,72rem)] flex-col items-center place-self-center py-10 text-center min-[40rem]:py-[4.5rem] min-[40rem]:pb-24"
>
  <h1
    class="m-0 font-sans text-[clamp(2.25rem,12vw,4.1rem)] leading-none font-[760] tracking-[-0.075em] text-balance min-[40rem]:text-[clamp(3.35rem,10.3vw,9rem)]"
    aria-label={tagline}
  >
    <span
      class="hero-intro block bg-[linear-gradient(90deg,transparent,var(--background)_4%,var(--background)_96%,transparent)] tracking-[0em] text-background [-webkit-text-stroke:4px_var(--muted-foreground)] [paint-order:stroke_fill] [--hero-intro-delay:0ms]"
      aria-hidden="true"
    >
      {m.web_landing_hero_headline_first()}
    </span>
    <span
      class="hero-intro block whitespace-nowrap tracking-[-0.02em] [word-spacing:0.08em] [--hero-intro-delay:55ms] min-[40rem]:whitespace-normal min-[40rem]:[word-spacing:normal]"
      aria-hidden="true"
    >
      {m.web_landing_hero_headline_second()}
    </span>
  </h1>

  <p
    class="hero-intro mt-6 max-w-80 text-[clamp(1rem,2.2vw,1.2rem)] leading-[1.6] text-balance text-neutral-600 [--hero-intro-delay:110ms] dark:text-[#aab1b9] min-[40rem]:mt-8 min-[40rem]:max-w-xl"
  >
    {m.web_landing_hero_description()}
  </p>

  <div class="hero-intro [--hero-intro-delay:150ms]">
    <ShipTargets />
  </div>

  <div
    class="hero-intro mt-9 grid w-[min(100%,26rem)] grid-cols-[auto_minmax(0,1fr)_auto] items-center rounded-[0.8rem] border border-neutral-300 bg-white/95 p-[0.35rem] text-left shadow-[0_1.5rem_5rem_rgb(0_0_0_/_10%),inset_0_1px_rgb(255_255_255_/_75%)] [--hero-intro-delay:190ms] dark:border-[#303842] dark:bg-[rgb(13_17_22_/_92%)] dark:shadow-[0_1.5rem_5rem_rgb(0_0_0_/_32%),inset_0_1px_rgb(255_255_255_/_4%)]"
  >
    <span class="pl-[0.9rem] font-mono text-[0.8rem] text-neutral-500 dark:text-[#aab1b9]" aria-hidden="true">$</span>
    <code
      class="overflow-hidden px-[0.65rem] py-[0.8rem] font-mono text-[clamp(0.68rem,2.2vw,0.83rem)] text-ellipsis whitespace-nowrap"
      translate="no">{SCAFFOLD_COMMAND}</code
    >
    <button
      class="group relative grid size-11 touch-manipulation cursor-pointer place-items-center rounded-[0.55rem] border border-neutral-300 bg-neutral-100 text-neutral-600 [transition:border-color_150ms_ease,color_150ms_ease,scale_120ms_cubic-bezier(0.215,0.61,0.355,1)] [-webkit-tap-highlight-color:transparent] hover:border-neutral-500 hover:text-neutral-950 active:scale-[0.97] focus-visible:rounded-[0.35rem] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-neutral-500 motion-reduce:transition-none dark:border-[#38414c] dark:bg-[#161c24] dark:text-[#c8cdd2] dark:hover:border-[#5b6978] dark:hover:text-[#f1f3f5] dark:focus-visible:outline-[#aab1b9]"
      type="button"
      data-copy-command={SCAFFOLD_COMMAND}
      data-copy-label={m.web_landing_command_copy_aria()}
      data-copied-label={m.web_landing_command_copied_aria()}
      data-copied-status={m.web_landing_command_copied_status()}
      data-copy-error={m.web_landing_command_copy_error()}
      aria-label={m.web_landing_command_copy_aria()}
    >
      <svg
        class="absolute size-[1.15rem] shrink-0 scale-100 rotate-0 fill-none stroke-current opacity-100 [stroke-linecap:round] [stroke-linejoin:round] [transition:opacity_150ms_cubic-bezier(0.215,0.61,0.355,1),scale_150ms_cubic-bezier(0.215,0.61,0.355,1),rotate_150ms_cubic-bezier(0.215,0.61,0.355,1)] group-data-[copied=true]:scale-75 group-data-[copied=true]:-rotate-6 group-data-[copied=true]:opacity-0 motion-reduce:transition-none"
        viewBox="0 0 16 16"
        aria-hidden="true"
      >
        <rect x="6.25" y="6.25" width="8.5" height="8.5" rx="1.5"></rect>
        <path d="M3.25 11.75h-.5a1.5 1.5 0 0 1-1.5-1.5v-7.5a1.5 1.5 0 0 1 1.5-1.5h7.5a1.5 1.5 0 0 1 1.5 1.5v.5"></path>
      </svg>
      <svg
        class="absolute size-[1.15rem] shrink-0 scale-75 rotate-6 fill-none stroke-current opacity-0 [stroke-linecap:round] [stroke-linejoin:round] [transition:opacity_150ms_cubic-bezier(0.215,0.61,0.355,1),scale_150ms_cubic-bezier(0.215,0.61,0.355,1),rotate_150ms_cubic-bezier(0.215,0.61,0.355,1)] group-data-[copied=true]:scale-100 group-data-[copied=true]:rotate-0 group-data-[copied=true]:opacity-100 motion-reduce:transition-none"
        viewBox="0 0 18 18"
        aria-hidden="true"
      >
        <path d="m3 9.5 3.5 3.5L15 4.5"></path>
      </svg>
    </button>
    <span class="sr-only" aria-live="polite" data-copy-status></span>
  </div>
</main>

<script>
  import { SCAFFOLD_COMMAND } from "#shared/constants"

  const copyButton = document.querySelector<HTMLButtonElement>("[data-copy-command]")
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]")
  let resetTimer: ReturnType<typeof setTimeout> | undefined

  const copyCommand = async function () {
    if (!copyButton || !copyStatus) return

    await navigator.clipboard.writeText(SCAFFOLD_COMMAND)
    copyButton.dataset.copied = "true"
    copyButton.setAttribute("aria-label", copyButton.dataset.copiedLabel ?? "")
    copyStatus.textContent = copyButton.dataset.copiedStatus ?? ""

    clearTimeout(resetTimer)
    resetTimer = setTimeout(() => {
      copyButton.dataset.copied = "false"
      copyButton.setAttribute("aria-label", copyButton.dataset.copyLabel ?? "")
      copyStatus.textContent = ""
    }, 2000)
  }

  copyButton?.addEventListener("click", () => {
    copyCommand().catch(() => {
      if (copyStatus) copyStatus.textContent = copyButton?.dataset.copyError ?? ""
    })
  })
</script>

<style>
  .hero-intro {
    animation: hero-intro 360ms cubic-bezier(0.165, 0.84, 0.44, 1) var(--hero-intro-delay) both;
  }

  @keyframes hero-intro {
    from {
      opacity: 0;
      transform: translateY(0.75rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-intro {
      animation: none;
    }
  }
</style>
