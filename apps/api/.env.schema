# @currentEnv=$VARLOCK_ENV
# @generateTsTypes(path=./src/shared/env.generated.ts, exposeEnv=local)
# @import(../../packages/auth/env/.env.server)
# @import(../../packages/db/env/.env.server)
# @import(../../packages/email/env/.env.server)
# @import(../../packages/kv/env/.env.server)
# @import(../../packages/observability/env/.env.build)
# @import(../../packages/observability/env/.env.server)
# @import(../../packages/workflows/env/.env.server)
# @defaultRequired=true @defaultSensitive=true

# ---

# Public URL where the API is reachable.
# @public @type=url
BASE_URL=

# Browser origins allowed by API CORS middleware.
# @public @type=array(string)
ALLOWED_API_ORIGINS=

# Local server port.
# @public @type=port
PORT=3000

# Shared credential used by authenticated file clients.
# @type=string(minLength=32)
FILES_API_SECRET=

# Object-storage access identifier.
S3_ACCESS_KEY_ID=

# Object-storage bucket name.
# @public
S3_BUCKET=

# Optional S3-compatible endpoint.
# @optional @public @type=url
S3_ENDPOINT=

# Optional object-storage region.
# @optional @public
S3_REGION=

# Object-storage secret credential.
S3_SECRET_ACCESS_KEY=

# Optional Portless URL supplied to local commands.
# @optional @public @type=url
PORTLESS_URL=

# Arcjet security credential.
ARCJET_KEY=
