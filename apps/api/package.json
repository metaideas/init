{
  "name": "api",
  "private": true,
  "description": "Hono API running on Bun",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "bun run --parallel \"codegen:*\"",
    "codegen:env": "varlock codegen",
    "codegen:i18n": "paraglide-js compile --project ../../tooling/internationalization/project.inlang --outdir ./src/shared/internationalization",
    "dev": "portless",
    "dev:app": "varlock run -- bun --no-env-file --hot src/index.ts",
    "env:check": "varlock load",
    "start": "varlock run -- bun --no-env-file --bun src/index.ts"
  },
  "dependencies": {
    "@arcjet/ip": "^1.9.1",
    "@hono/standard-validator": "^0.2.3",
    "@hono/trpc-server": "0.4.2",
    "@init/auth": "workspace:*",
    "@init/db": "workspace:*",
    "@init/email": "workspace:*",
    "@init/kv": "workspace:*",
    "@init/observability": "workspace:*",
    "@init/utils": "workspace:*",
    "@init/workflows": "workspace:*",
    "@scalar/hono-api-reference": "^0.9.48",
    "@trpc/server": "11.8.1",
    "files-sdk": "2.2.2",
    "hono": "4.12.32",
    "hono-openapi": "^1.3.1",
    "hono-rate-limiter": "0.5.3",
    "qte": "0.1.1",
    "superjson": "2.2.6",
    "varlock": "1.16.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.23.0",
    "@tooling/tsconfig": "workspace:*",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "portless": {
    "name": "api.init",
    "script": "dev:app"
  }
}
