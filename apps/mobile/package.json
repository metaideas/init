{
  "name": "mobile",
  "private": true,
  "description": "Expo application deployed with EAS",
  "main": "src/index.ts",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "android": "expo run:android",
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo .expo dist node_modules",
    "codegen": "bun run scripts/codegen.ts",
    "dev": "expo start --port 3002",
    "dev:android": "expo start --android",
    "dev:ios": "expo start --ios",
    "doctor": "expo-doctor",
    "install:check": "expo install --check",
    "install:fix": "expo install --fix",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "start": "expo start",
    "test": "bun test",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/react-native-action-sheet": "4.1.1",
    "@init/env": "workspace:*",
    "@init/native-ui": "workspace:*",
    "@init/observability": "workspace:*",
    "@init/utils": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/portal": "1.3.0",
    "@sentry/react-native": "~7.2.0",
    "@tanstack/query-async-storage-persister": "5.90.18",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-persist-client": "5.90.18",
    "expo": "~54.0.33",
    "expo-constants": "~18.0.12",
    "expo-dev-client": "~6.0.20",
    "expo-font": "~14.0.10",
    "expo-glass-effect": "~0.1.9",
    "expo-linking": "~8.0.10",
    "expo-router": "~6.0.20",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "^1.20.7",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "std-env": "4.2.0",
    "superjson": "2.2.6",
    "tailwindcss": "4.3.3",
    "uniwind": "1.3.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.23.0",
    "@sentry/cli": "2.56.0",
    "@tooling/tsconfig": "workspace:*",
    "@types/react": "19.1.13",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-preset-expo": "~54.0.0",
    "expo-doctor": "1.17.14",
    "typescript": "7.0.2"
  }
}
