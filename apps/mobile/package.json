{
  "name": "mobile",
  "private": true,
  "description": "Expo application deployed with EAS",
  "main": "src/index.ts",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "android": "expo run:android",
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo .expo dist node_modules",
    "codegen": "bun run scripts/codegen.ts",
    "dev": "portless",
    "dev:android": "expo start --android",
    "dev:app": "expo start --port ${PORT:-3002}",
    "dev:ios": "expo start --ios",
    "doctor": "expo-doctor",
    "install:check": "expo install --check",
    "install:fix": "expo install --fix",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --clean",
    "start": "expo start",
    "test": "bun test",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.8",
    "@expo/react-native-action-sheet": "4.1.1",
    "@init/env": "workspace:*",
    "@init/native-ui": "workspace:*",
    "@init/observability": "workspace:*",
    "@init/utils": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/portal": "1.3.0",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/query-async-storage-persister": "5.90.18",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-query-persist-client": "5.90.18",
    "expo": "~57.0.10",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.10",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "std-env": "4.2.0",
    "superjson": "2.2.6",
    "tailwindcss": "4.3.3",
    "uniwind": "1.10.1"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.23.0",
    "@sentry/cli": "2.56.0",
    "@tooling/tsconfig": "workspace:*",
    "@types/react": "19.2.4",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-preset-expo": "~57.0.0",
    "expo-doctor": "1.20.1",
    "typescript": "7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "portless": {
    "name": "mobile.init",
    "script": "dev:app"
  }
}
