# @currentEnv=$VARLOCK_ENV
# @generateTsTypes(path=./src/shared/env.generated.ts, exposeEnv=local)
# @import(../../packages/auth/env/.env.server)
# @import(../../packages/db/env/.env.server)
# @import(../../packages/email/env/.env.server)
# @import(../../packages/observability/env/.env.client, pick=[PUBLIC_*])
# @defaultRequired=true @defaultSensitive=false @defaultDynamic=false

# ---

# Canonical application URL.
# @type=url(matches=/^https?:\/\//)
PUBLIC_BASE_URL=

# Optional remote API URL; absence keeps the local TanStack Start backend.
# @optional @type=url(matches=/^https?:\/\//)
PUBLIC_API_URL=

# Optional Portless URL supplied to local server commands.
# @optional @dynamic @type=url
PORTLESS_URL=

# Local Vite server port.
# @dynamic @type=port
PORT=3001
