{
  "name": "app",
  "private": true,
  "description": "Full-stack TanStack Start application with local server functions",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "bun --bun vite build",
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "bun run --parallel \"codegen:*\"",
    "codegen:env": "varlock codegen",
    "codegen:i18n": "paraglide-js compile --project ../../tooling/internationalization/project.inlang --outdir ./src/shared/internationalization",
    "dev": "portless",
    "dev:app": "bun --bun vite dev",
    "env:check": "varlock load",
    "env:scan": "test -d .output/public && varlock scan --path .env.schema --path .env.development .output/public",
    "env:scan:build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "start": "varlock run -- node .output/server/index.mjs"
  },
  "dependencies": {
    "@init/ai": "workspace:*",
    "@init/auth": "workspace:*",
    "@init/core": "workspace:*",
    "@init/db": "workspace:*",
    "@init/email": "workspace:*",
    "@init/observability": "workspace:*",
    "@init/ui": "workspace:*",
    "@init/utils": "workspace:*",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-router-ssr-query": "1.167.1",
    "@tanstack/react-start": "1.168.32",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "superjson": "2.2.6",
    "varlock": "1.16.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.23.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-form-devtools": "0.2.13",
    "@tanstack/react-query-devtools": "5.91.2",
    "@tanstack/react-router-devtools": "1.167.0",
    "@tooling/internationalization": "workspace:*",
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "24.10.1",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.1.9",
    "@varlock/vite-integration": "1.4.0",
    "@vitejs/plugin-react": "6.1.0",
    "nitro": "3.0.260610-beta",
    "oxc-transform-react": "0.145.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  },
  "portless": {
    "name": "app.init",
    "script": "dev:app"
  }
}
