{{#if addOpenai}}
export const openai = () =>
  createEnv({
    runtimeEnv: env,
    server: {
      OPENAI_API_KEY: z.string(),
    },
    skipValidation: isCI,
  })

{{/if}}
{{#if addAnthropic}}
export const anthropic = () =>
  createEnv({
    runtimeEnv: env,
    server: {
      ANTHROPIC_API_KEY: z.string(),
    },
    skipValidation: isCI,
  })

{{/if}}
{{#if addS3}}
export const s3 = () =>
  createEnv({
    runtimeEnv: env,
    server: {
      S3_ACCESS_KEY_ID: z.string(),
      S3_BUCKET: z.string().optional(),
      S3_ENDPOINT: z.string().optional(),
      S3_REGION: z.string().optional(),
      S3_SECRET_ACCESS_KEY: z.string(),
    },
    skipValidation: isCI,
  })

{{/if}}
